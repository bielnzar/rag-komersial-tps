# Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# =============================================================
# 🔑 KREDENSIAL & ENVIRONMENT VARIABLES (SANGAT PENTING)
# =============================================================
.env
.env.*
!.env.example
credentials/
credentials/*
*.key
*.pem
*.cert

# =============================================================
# 🗄️ DATABASES & RAW/PROCESSED DATA
# =============================================================
# Mengabaikan file database DuckDB
*.duckdb
*.duckdb.wal
data/processed/*.duckdb
data/processed/*.duckdb.wal

# Mengabaikan data mentah, spreadsheet Excel, CSV hasil ETL, dan sesi user
data/raw/*.xlsx
data/raw/*.xls
data/raw/csv/
data/bronze/
data/silver/
data/gold/
data/sessions/

# Tetap melacak script Python dan file .gitkeep di dalam folder data
!data/**/.gitkeep
!data/**/*.py

# =============================================================
# 📜 LOGS & RUNTIME DATA
# =============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

